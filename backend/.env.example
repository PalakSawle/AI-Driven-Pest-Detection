# ---- copy to backend/.env for local runs; set the same keys in Render ----
ENVIRONMENT=development
# SQLite locally; Supabase Postgres in production (Project Settings > Database > Connection string, URI, pooler 6543 or direct 5432)
DATABASE_URL=sqlite:///./agriguard.db
# Long random string: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Model (ONNX export of the trained YOLO model + its metadata)
MODEL_PATH=weights/best.onnx
MODEL_META_PATH=weights/model_meta.json
CONF_THRESHOLD=0.25
LOW_CONF_THRESHOLD=0.40

# Storage: local (dev) or supabase (prod — private bucket "detections")
STORAGE_BACKEND=local
UPLOAD_DIR=uploads
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=detections

# Chatbot LLM: anthropic | openai | gemini | none (none = curated knowledge-base answers)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=

# Weather: open-meteo (free, no key) or openweather (needs WEATHER_API_KEY)
WEATHER_PROVIDER=open-meteo
WEATHER_API_KEY=

# Optional email alerts / password-reset mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# First admin account (created at startup if it doesn't exist)
ADMIN_EMAIL=
ADMIN_PASSWORD=
